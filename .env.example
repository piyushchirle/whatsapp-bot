# OpenCode Zen API
OPENCODE_API_KEY=your_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=nemotron-3-ultra-free

# Bot behavior
BOT_NAME=Jarvis
REPLY_TO_GROUPS=false
MAX_HISTORY_TURNS=10
SYSTEM_PROMPT="You are a helpful, concise WhatsApp assistant. Keep replies short and natural, like a real chat message. Avoid long paragraphs unless explicitly asked for detail."

# Owner number (with country code, no +, no spaces) - used for admin commands
OWNER_NUMBER=91XXXXXXXXXX
